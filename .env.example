# Supabase Frontend Credentials
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_ENABLE_DEV=true

# Single Tenant Business Config (Overrides default Apex Plumbing config)
VITE_BUSINESS_NAME="Apex Plumbing & Heating"
VITE_BUSINESS_TAGLINE="24/7 Professional Voice AI Desk"
VITE_BUSINESS_TIMEZONE="America/New_York"
VITE_BUSINESS_PHONE="+1 (555) 234-5678"
VITE_RETELL_AGENT_ID="agent_demo_123"
VITE_GOOGLE_CALENDAR_ID="primary"
VITE_ACCENT_COLOR="#2563eb"

# Backend Secrets (Set in Supabase Edge Functions Secrets environment)
RETELL_API_KEY=key_retell_sample_secret
RETELL_WEBHOOK_SECRET=secret_retell_webhook_sample
GOOGLE_CLIENT_ID=google_oauth_client_id
GOOGLE_CLIENT_SECRET=google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=google_oauth_refresh_token
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
